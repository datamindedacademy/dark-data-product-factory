{
  "name": "capstone-slides",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev slides.md --open",
    "build": "slidev build slides.md",
    "pdf": "slidev export slides.md --output capstone.pdf --timeout 60000",
    "pptx": "slidev export slides.md --format pptx --output capstone.pptx --timeout 60000"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.104",
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "playwright-chromium": "^1.64.1"
  }
}
